# Copy this file to `.env.local` and fill in values from your Supabase project
# (Supabase dashboard -> Project Settings -> API Keys).
#
# Leave these blank to run the app in DEMO MODE with bundled sample data.
#
# Only use the PUBLIC browser key here: the "publishable" key (sb_publishable_...)
# or, on older projects, the legacy "anon" key. NEVER put the secret /
# service_role key in any VITE_ variable: everything prefixed with VITE_ is
# bundled into the website and visible to anyone.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
